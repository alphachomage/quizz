{
  "name": "voltquiz",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/gen-manifest.mjs && node scripts/gen-corpus-json.mjs",
    "prebuild": "node scripts/gen-manifest.mjs && node scripts/gen-corpus-json.mjs",
    "gen:manifest": "node scripts/gen-manifest.mjs",
    "gen:corpus": "node scripts/gen-corpus-json.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy:preview": "vite build && wrangler deploy --env preview",
    "deploy": "vite build && wrangler deploy",
    "lint": "eslint src tests worker.ts worker-api.ts api durable-objects scripts vite.config.ts vitest.config.ts eslint.config.js",
    "lint:arch": "madge --circular --ts-config tsconfig.json --extensions ts,tsx src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:data": "vitest run tests/data",
    "test:scoring": "vitest run tests/unit/lib/scoring.test.ts",
    "count:questions": "node scripts/count-questions.mjs",
    "audit:questions": "node scripts/audit-questions.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tail": "wrangler tail --format pretty",
    "test:game": "vitest run tests/integration/game-solo.test.tsx",
    "test:game:duel": "vitest run tests/integration/game-duel.test.tsx",
    "test:game:rogue": "vitest run tests/integration/game-rogue.test.tsx",
    "test:game:daily": "vitest run tests/integration/game-daily.test.tsx",
    "test:draw": "vitest run tests/unit/lib/draw.test.ts",
    "test:similarity": "vitest run tests/unit/lib/similarity.test.ts",
    "test:accounts": "vitest run tests/unit/lib/accounts.test.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply voltquiz --local",
    "db:migrate": "wrangler d1 migrations apply voltquiz --remote"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "madge": "^8.0.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.4.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.1.1",
    "wrangler": "^4.165.0"
  }
}
