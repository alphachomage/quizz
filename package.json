{
  "name": "voltquiz",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/gen-manifest.mjs",
    "prebuild": "node scripts/gen-manifest.mjs",
    "gen:manifest": "node scripts/gen-manifest.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "lint": "eslint src tests worker.js vite.config.js vitest.config.js eslint.config.js",
    "lint:arch": "madge --circular --extensions js,jsx src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:data": "vitest run tests/data",
    "test:partie": "vitest run tests/integration/partie-solo.test.jsx",
    "test:partie:duel": "vitest run tests/integration/partie-duel.test.jsx",
    "test:partie:survie": "vitest run tests/integration/partie-survie.test.jsx",
    "test:partie:quotidien": "vitest run tests/integration/partie-quotidien.test.jsx",
    "test:scoring": "vitest run tests/unit/lib/scoring.test.js",
    "test:tirage": "vitest run tests/unit/lib/tirage.test.js",
    "test:similarite": "vitest run tests/unit/lib/similarite.test.js",
    "test:comptes": "vitest run tests/unit/lib/comptes.test.js",
    "test:legacy": "node test-unitaire.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "tail": "wrangler tail --format pretty"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@cloudflare/vite-plugin": "^1.70.1",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "madge": "^8.0.0",
    "prettier": "^3.10.1",
    "vite": "^6.4.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.1.1",
    "wrangler": "^4.165.0"
  }
}
